<Window x:Class="UnitSchedulePlugin.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unit Schedule - Revit Plugin"
        Height="800" Width="1400"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F9FAFB">

    <!--
    Main Window for Unit Schedule Plugin (Pure WPF - No External Dependencies)
    单元时间表插件主窗口（纯 WPF - 无外部依赖）
    -->

    <Window.Resources>
        <!-- Color Definitions | 颜色定义 -->
        <SolidColorBrush x:Key="DeepBlueBrush" Color="#1E3A8A"/>
        <SolidColorBrush x:Key="TealBrush" Color="#14B8A6"/>
        <SolidColorBrush x:Key="AmberBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#111827"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>

        <!-- Card Style | 卡片样式 -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Statistic Card Style | 统计卡片样式 -->
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="MinWidth" Value="200"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.08" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button Style | 按钮样式 -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource DeepBlueBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E40AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Button Style | 次要按钮样式 -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource DeepBlueBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DeepBlueBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid Style | 数据网格样式 -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F3F4F6"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFAFA"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox Style | 文本框样式 -->
        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- ComboBox Style | 下拉框样式 -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header | 标题栏 -->
        <Border Grid.Row="0" Padding="24,16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1E3A8A" Offset="0"/>
                    <GradientStop Color="#2563EB" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <TextBlock Text="Unit Schedule"
                               FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{Binding ProjectName, StringFormat='Project: {0}'}"
                               FontSize="14" Foreground="#BFDBFE" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Refresh" Style="{StaticResource SecondaryButtonStyle}"
                            Foreground="White" BorderBrush="White"
                            Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
                    <Button Content="Export All" Style="{StaticResource PrimaryButtonStyle}"
                            Background="{StaticResource TealBrush}"
                            Command="{Binding ExportAllCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content | 主内容区 -->
        <TabControl Grid.Row="1" Margin="16"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="16,10"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource DeepBlueBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>

            <!-- Dashboard Tab | 仪表板标签页 -->
            <TabItem Header="Dashboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Statistics Cards | 统计卡片 -->
                        <TextBlock Text="Project Overview" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="8,8,8,0"/>

                        <WrapPanel Margin="0,8">
                            <Border Style="{StaticResource StatCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Total Units" FontSize="13"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding Statistics.TotalUnits}"
                                               FontSize="32" FontWeight="Bold"
                                               Foreground="{StaticResource DeepBlueBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource StatCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Total Gross Area" FontSize="13"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding Statistics.FormattedTotalGrossArea}"
                                               FontSize="32" FontWeight="Bold"
                                               Foreground="{StaticResource TealBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource StatCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Total Net Area" FontSize="13"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding Statistics.FormattedTotalNetArea}"
                                               FontSize="32" FontWeight="Bold"
                                               Foreground="{StaticResource AmberBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource StatCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Overall Efficiency" FontSize="13"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding Statistics.FormattedEfficiency}"
                                               FontSize="32" FontWeight="Bold"
                                               Foreground="{StaticResource DeepBlueBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource StatCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Private Open Space" FontSize="13"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding Statistics.FormattedTotalPrivateOpenSpace}"
                                               FontSize="32" FontWeight="Bold"
                                               Foreground="{StaticResource TealBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource StatCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Public Open Space" FontSize="13"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding Statistics.FormattedTotalPublicOpenSpace}"
                                               FontSize="32" FontWeight="Bold"
                                               Foreground="{StaticResource AmberBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <!-- Charts Row | 图表行 -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Unit Mix Chart (Bar Chart) | 单元组合图（条形图）-->
                            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Unit Mix Distribution" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                    <ItemsControl ItemsSource="{Binding UnitMixChartData}" Height="280">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="60"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                               VerticalAlignment="Center" FontSize="12"/>
                                                    <Border Grid.Column="1" Height="24" Margin="8,0"
                                                            Background="{Binding Color}" CornerRadius="4"
                                                            HorizontalAlignment="Left">
                                                        <Border.Width>
                                                            <MultiBinding Converter="{x:Null}">
                                                                <Binding Path="Percentage"/>
                                                            </MultiBinding>
                                                        </Border.Width>
                                                    </Border>
                                                    <ProgressBar Grid.Column="1" Height="24" Margin="8,0"
                                                                 Value="{Binding Percentage}" Maximum="100"
                                                                 Foreground="{Binding Color}" Background="#F3F4F6"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Value}"
                                                               VerticalAlignment="Center" HorizontalAlignment="Right"
                                                               FontWeight="SemiBold" FontSize="12"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Bedroom Mix Chart | 卧室组合图 -->
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Bedroom Mix" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                    <ItemsControl ItemsSource="{Binding BedroomMixChartData}" Height="280">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="60"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                               VerticalAlignment="Center" FontSize="12"/>
                                                    <ProgressBar Grid.Column="1" Height="24" Margin="8,0"
                                                                 Value="{Binding Percentage}" Maximum="100"
                                                                 Foreground="{Binding Color}" Background="#F3F4F6"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Value}"
                                                               VerticalAlignment="Center" HorizontalAlignment="Right"
                                                               FontWeight="SemiBold" FontSize="12"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Area by Type Chart | 按类型划分面积图 -->
                        <Border Style="{StaticResource CardStyle}" Margin="8,16,8,8">
                            <StackPanel>
                                <TextBlock Text="Area by Unit Type" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                <ItemsControl ItemsSource="{Binding AreaByTypeChartData}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="120"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                           VerticalAlignment="Center" FontSize="13"/>
                                                <ProgressBar Grid.Column="1" Height="28" Margin="8,0"
                                                             Value="{Binding Percentage}" Maximum="100"
                                                             Foreground="{Binding Color}" Background="#F3F4F6"/>
                                                <TextBlock Grid.Column="2" Text="{Binding DisplayText}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                                           FontWeight="SemiBold" FontSize="13"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Open Space Chart | 开放空间图 -->
                        <Border Style="{StaticResource CardStyle}" Margin="8,0,8,8">
                            <StackPanel>
                                <TextBlock Text="Open Space Distribution" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                <ItemsControl ItemsSource="{Binding OpenSpaceChartData}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="180"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="16" Height="16" CornerRadius="3"
                                                            Background="{Binding Color}" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding Label}" FontSize="13"/>
                                                </StackPanel>
                                                <ProgressBar Grid.Column="1" Height="24" Margin="8,0"
                                                             Value="{Binding Percentage}" Maximum="100"
                                                             Foreground="{Binding Color}" Background="#F3F4F6"/>
                                                <TextBlock Grid.Column="2" Text="{Binding DisplayText}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                                           FontWeight="SemiBold" FontSize="13"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Unit Schedule Tab | 单元时间表标签页 -->
            <TabItem Header="Unit Schedule">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filters | 过滤器 -->
                    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Style="{StaticResource SearchBoxStyle}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Search units by number, name, or type"/>

                            <ComboBox Grid.Column="1" Margin="12,0,0,0" MinWidth="150"
                                      ItemsSource="{Binding UnitTypes}"
                                      SelectedItem="{Binding SelectedUnitType}"/>

                            <ComboBox Grid.Column="2" Margin="12,0,0,0" MinWidth="150"
                                      ItemsSource="{Binding Levels}"
                                      SelectedItem="{Binding SelectedLevel}"/>

                            <Button Grid.Column="3" Content="Clear Filters" Margin="12,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ClearFiltersCommand}"/>

                            <Button Grid.Column="4" Content="Export Units" Margin="12,0,0,0"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding ExportUnitsCommand}"/>
                        </Grid>
                    </Border>

                    <!-- Units DataGrid | 单元数据网格 -->
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="8,0,8,8" Padding="0">
                        <DataGrid ItemsSource="{Binding FilteredUnits}"
                                  SelectedItem="{Binding SelectedUnit}"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Unit #" Binding="{Binding UnitNumber}" Width="80"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding UnitType}" Width="100"/>
                                <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="100"/>
                                <DataGridTextColumn Header="Bedrooms" Binding="{Binding BedroomCount}" Width="80"/>
                                <DataGridTextColumn Header="Gross Area" Binding="{Binding FormattedGrossArea}" Width="100"/>
                                <DataGridTextColumn Header="Net Area" Binding="{Binding FormattedNetArea}" Width="100"/>
                                <DataGridTextColumn Header="Private Open Space" Binding="{Binding FormattedPrivateOpenSpace}" Width="130"/>
                                <DataGridTextColumn Header="Sellable Area" Binding="{Binding SellableArea, StringFormat='{}{0:N0} SF'}" Width="110"/>
                                <DataGridTextColumn Header="Efficiency" Binding="{Binding FormattedEfficiency}" Width="90"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Private Open Spaces Tab | 私有开放空间标签页 -->
            <TabItem Header="Private Open Spaces">
                <Border Style="{StaticResource CardStyle}" Margin="8" Padding="0">
                    <DataGrid ItemsSource="{Binding PrivateOpenSpaces}"
                              SelectedItem="{Binding SelectedOpenSpace}"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Space #" Binding="{Binding SpaceNumber}" Width="80"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding SpaceTypeName}" Width="100"/>
                            <DataGridTextColumn Header="Associated Unit" Binding="{Binding AssociatedUnitNumber}" Width="120"/>
                            <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="100"/>
                            <DataGridTextColumn Header="Area" Binding="{Binding FormattedArea}" Width="100"/>
                            <DataGridTextColumn Header="Covered Area" Binding="{Binding FormattedCoveredArea}" Width="110"/>
                            <DataGridTextColumn Header="Coverage" Binding="{Binding CoverageDescription}" Width="90"/>
                            <DataGridTextColumn Header="Sellable Contribution" Binding="{Binding FormattedSellableContribution}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <!-- Public Open Spaces Tab | 公共开放空间标签页 -->
            <TabItem Header="Public Open Spaces">
                <Border Style="{StaticResource CardStyle}" Margin="8" Padding="0">
                    <DataGrid ItemsSource="{Binding PublicOpenSpaces}"
                              SelectedItem="{Binding SelectedOpenSpace}"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Space #" Binding="{Binding SpaceNumber}" Width="80"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding SpaceTypeName}" Width="120"/>
                            <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="100"/>
                            <DataGridTextColumn Header="Building" Binding="{Binding Building}" Width="100"/>
                            <DataGridTextColumn Header="Area" Binding="{Binding FormattedArea}" Width="100"/>
                            <DataGridTextColumn Header="Coverage" Binding="{Binding CoverageDescription}" Width="90"/>
                            <DataGridTextColumn Header="Rooftop" Binding="{Binding IsRooftop}" Width="80"/>
                            <DataGridTextColumn Header="At Grade" Binding="{Binding IsAtGrade}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <!-- Export Tab | 导出标签页 -->
            <TabItem Header="Export">
                <Border Style="{StaticResource CardStyle}" Margin="8">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
                        <TextBlock Text="Export Options" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,24"/>

                        <Button Content="Export Unit Schedule (CSV)"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ExportUnitsCommand}"
                                HorizontalAlignment="Stretch" Margin="0,8"/>

                        <Button Content="Export All Data (CSV)"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Background="{StaticResource TealBrush}"
                                Command="{Binding ExportAllCommand}"
                                HorizontalAlignment="Stretch" Margin="0,8"/>

                        <Button Content="Export Summary Report (TXT)"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ExportReportCommand}"
                                HorizontalAlignment="Stretch" Margin="0,8"/>

                        <TextBlock Text="All areas are in Square Feet (SF)"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,24,0,0"/>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
